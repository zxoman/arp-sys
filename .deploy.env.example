# Machine-specific deploy settings — copy this file to `.deploy.env` and edit it.
#
# `.deploy.env` is git-ignored on purpose: it holds the server address and the passwords, so it must
# never be committed. Keep it readable by you only:  chmod 600 .deploy.env
#
# Everything here is optional; the script has sensible defaults.

# Where the site lives (also used for ssh and rsync).
# DEPLOY_HOST=server@192.168.1.50
DEPLOY_HOST=server@192.168.1.50

# Project directory on the server.
# DEPLOY_PATH=/var/www/arp-sys

# Branch to deploy and the URL checked at the end (defaults to http://<host>).
# DEPLOY_BRANCH=master
# DEPLOY_URL=http://aqar.lan

# PHP binary on the server.
# REMOTE_PHP=php

# Password for ssh/rsync (needs sshpass). Leave empty when you use ssh keys.
# SSH_PASS=

# Password for the storage-ownership step (sudo). Optional.
# SUDO_PASS=

# Where the database archive is copied on this machine.
# DEPLOY_BACKUP_DIR=$HOME/arp-deploy-backups
